# Copy to .env.local and fill in. Never commit real values.
# The app talks to Supabase only. If these are missing, it says so instead of showing anything made up.

# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=https://grkimwkfyfzlivjgtrfg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imdya2ltd2tmeWZ6bGl2amd0cmZnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTEyNzcyMDMsImV4cCI6MjEwNjg1MzIwM30.81Lfq70O7nF8--VHGqtvsw11aGDsOaTCgoz0iiFH6dc
# Public site address, used in auth emails and links
NEXT_PUBLIC_SITE_URL=https://powerproof.app/

# Server only
SUPABASE_SERVICE_ROLE_KEY=
# Payments (Razorpay). Without the first two, checkout says payments aren't connected.
# Webhook: https://<your site>/api/webhooks/razorpay, events payment.captured, order.paid, payment.failed,
# signed with RAZORPAY_WEBHOOK_SECRET (it catches buyers who close the tab after paying).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Email (Resend): order receipts and resending them. MAIL_FROM must be on a domain
# verified with Resend, like "PowerProof <orders@yourdomain.com>". Without both, nothing is sent and screens say so.
RESEND_API_KEY=
MAIL_FROM=
# Custom domains (Pro): attached to this deployment through Vercel. VERCEL_TEAM_ID only for a team project.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
AI_IMAGE_API_KEY=
# GST lookup (Settings > Company): fills the registered name and address from a GSTIN. Optional.
# URL is the provider's address with {gstin} where the number goes. Without these, the form still checks
# the number and fills the state and PAN from it, and says live lookup isn't connected.
GST_LOOKUP_URL=
GST_LOOKUP_KEY=
GST_LOOKUP_KEY_HEADER=x-api-key

# Tests only (put these in .env.test.local). Two throwaway creator accounts on the real project.
# The end-to-end and integration tests sign in as them, create their own data, and delete it again.
# Creator A gets test data; creator B is kept empty so a brand-new account's screens can be checked.
TEST_CREATOR_A_EMAIL=
TEST_CREATOR_A_PASSWORD=
TEST_CREATOR_B_EMAIL=
TEST_CREATOR_B_PASSWORD=
# Optional. With SUPABASE_SERVICE_ROLE_KEY the e2e setup also puts creator A on Pro for the run
# (more than one product) and adds a paid order with a review, which creators can't create
# themselves. Both are put back at the end. Without it, the tests that need them are skipped.
