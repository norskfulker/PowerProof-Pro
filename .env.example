# Copy to .env.local and fill in real values. .env.local is never committed.
# On Cloudflare, set these same names in the dashboard instead of using a file.

# Baked into the client bundle at build time (required to build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Server only (never NEXT_PUBLIC_*). Needed at runtime, not for the build.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
GEMINI_API_KEY=
GEMINI_MODEL=
CRON_SECRET=

# Optional integrations (leave empty when not connected).
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
AI_IMAGE_API_KEY=
GST_LOOKUP_URL=
GST_LOOKUP_KEY=
GST_LOOKUP_KEY_HEADER=
SEND_EMAIL_HOOK_SECRET=

# Local test accounts (empty in production).
TEST_CREATOR_A_EMAIL=
TEST_CREATOR_A_PASSWORD=
TEST_CREATOR_B_EMAIL=
TEST_CREATOR_B_PASSWORD=
