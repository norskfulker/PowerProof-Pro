# Copy to .env.local and fill in real values. .env.local is never committed.
# On Cloudflare, set these same names in the dashboard instead of using a file.

# Baked into the client bundle at build time (required to build).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
next line is optional, but recommended to avoid CORS issues when using the Supabase client in the browser.

# Server only (never NEXT_PUBLIC_*). Needed at runtime, not for the build.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
GEMINI_API_KEY=
GEMINI_MODEL=
CRON_SECRET=

# Optional integrations (leave empty when not connected).
RAZORPAY_PRO_PLAN_ID=
GST_LOOKUP_URL=
GST_LOOKUP_KEY=
GST_LOOKUP_KEY_HEADER=
SEND_EMAIL_HOOK_SECRET=

# Custom domains only (leave unset until that setup; the app treats missing as off).
# One-time zone setup and the exact values: node scripts/setup-custom-domains.mjs
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_CNAME_TARGET=
# CLOUDFLARE_APEX_IPS=

# Local test accounts (empty in production).
TEST_CREATOR_A_EMAIL=
TEST_CREATOR_A_PASSWORD=
TEST_CREATOR_B_EMAIL=
TEST_CREATOR_B_PASSWORD=
