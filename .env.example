# Copy to .env.local and fill in. Never commit real values.
# Browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "mock" to use the in-browser demo data instead of Supabase
NEXT_PUBLIC_BACKEND=
# Public site address, used in auth emails and links
NEXT_PUBLIC_SITE_URL=

# Server only
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
AI_IMAGE_API_KEY=
